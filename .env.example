# Isi dari Firebase Console > Project settings > Your apps (Web).
# Biarkan kosong untuk menjalankan MODE LOKAL (data tersimpan di browser, cocok untuk simulasi/praktikum).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true = sambungkan ke Firebase Emulator Suite (localhost)
VITE_USE_EMULATOR=false
